# Локальные настройки. Скопируйте файл:  cp .env.example .env
# Файл .env НЕЛЬЗЯ коммитить (он в .gitignore). В .env.example - только безопасные примеры.
#
# Эти переменные читает app/core/config.py.

# Окружение. Допустимы ТОЛЬКО: dev | stage | prod | test (иначе приложение упадёт с KeyError).
ENV=dev

# Имя базы данных, которую создаст PostgreSQL при первом запуске.
# Должно соответствовать ENV: dev -> dev-fca, stage -> stage-fca, prod -> fca, test -> test-fca
POSTGRES_DB=dev-fca

# Тип БД (для PostgreSQL всегда postgresql)
DB=postgresql

# Доступ к PostgreSQL. DB_HOST=db - это имя сервиса из docker-compose.yml.
# Если запускаете приложение не в Docker, а БД в Docker - поставьте DB_HOST=localhost.
DB_USER=app
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Секрет для подписи JWT-токенов. Сгенерировать: openssl rand -hex 32
SECRET_KEY=change-me-too

# ВАЖНО: пароль подставляется в строку подключения без экранирования.
# Используйте только буквы и цифры (без @ : / # ? % и пробелов), иначе подключение сломается.
